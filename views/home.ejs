<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Trace — URL Shortener</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #090d0b;
            --surface: #101613;
            --surface-secondary: #141b17;
            --border: #26332d;
            --border-strong: #334139;
            --text: #f5f7f6;
            --secondary: #9aa7a0;
            --muted: #6f7c74;
            --accent: #63d39b;
            --accent-hover: #7be0ab;
            --accent-surface: #14261d;
        }

        html {
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            color: var(--text);
            font-family:
                Inter,
                -apple-system,
                BlinkMacSystemFont,
                "Roboto",
                "Helvetica",
                "Arial",
                "Segoe UI",
                sans-serif;
            background: var(--bg);
            padding: 24px 24px;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        input {
            font: inherit;
        }

        .container {
            width: min(1120px, 100%);
            margin: 0 auto;
            overflow: hidden;
            position: relative;
            z-index: 1;
            border: 1px solid var(--border-strong);
            border-radius: 24px;
            background: var(--surface);
            box-shadow: 0 24px 56px rgba(0, 0, 0, 0.38);
        }

        /* NAVBAR */

        nav {
            height: 74px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 0 36px;
            border-bottom: 1px solid var(--border);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;

            font-size: 19px;
            font-weight: 700;

            letter-spacing: -0.5px;
        }

        .brand-icon {
            width: 36px;
            height: 36px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 7px;

            background: var(--accent);

            color: #07100b;

            font-size: 16px;
            font-weight: 700;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 24px;
        }

        .brand-copy {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .brand-name {
            font-size: 19px;
            line-height: 1.1;
        }

        .brand-tagline {
            color: var(--secondary);
            font-size: 11px;
            font-weight: 400;
            letter-spacing: 0;
        }

        .nav-link {
            color: var(--muted);

            font-size: 13px;
            font-weight: 500;

            transition: color 0.2s ease;
        }

        .nav-link:hover {
            color: var(--text);
        }

        .nav-button {
            padding: 9px 15px;

            border: 1px solid var(--border-strong);
            border-radius: 7px;

            background: transparent;
            color: var(--text);

            font-size: 13px;
            font-weight: 600;

            transition:
                background 0.2s ease,
                border-color 0.2s ease;
        }

        .nav-button:hover {
            background: var(--surface-secondary);
            border-color: var(--border-strong);
        }

        /* HERO */

        main {
            padding: 46px 40px 34px;
        }

        .hero {
            max-width: 850px;
            margin: 0 auto;

            text-align: center;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;

            margin-bottom: 15px;

            color: var(--accent);

            font-size: 11px;
            font-weight: 700;

            letter-spacing: 1.6px;
            text-transform: uppercase;
        }

        .eyebrow-dot {
            width: 6px;
            height: 6px;

            border-radius: 50%;

            background: var(--accent);

            box-shadow: none;
        }

        h1 {
            max-width: 800px;
            margin: 0 auto 16px;

            font-size: 58px;
            line-height: 1.08;

            letter-spacing: 0;
            font-weight: 750;
        }

        h1 .accent {
            color: var(--accent);
        }

        .description {
            max-width: 570px;
            margin: 0 auto;

            color: var(--muted);

            font-size: 15px;
            line-height: 1.7;
        }

        /* SHORTENER CARD */

        .shortener-card {
            max-width: 760px;

            margin: 30px auto 0;
            padding: 9px;

            border: 1px solid var(--border-strong);
            border-radius: 12px;

            background: var(--surface-secondary);

            box-shadow:
                0 14px 32px rgba(0, 0, 0, 0.24);
        }

        .url-form {
            display: flex;
            align-items: center;
        }

        .url-input {
            flex: 1;
            min-width: 0;

            margin-right: 9px;
            padding: 14px 15px;

            border: 1px solid var(--border);
            border-radius: 6px;
            outline: none;

            background: #0d1210;
            color: var(--text);

            font-size: 14px;
            transition: border-color 0.2s ease;
        }

        .url-input:focus {
            border-color: var(--accent);
            box-shadow: none;
        }

        .url-input::placeholder {
            color: var(--muted);
        }

        .shorten-button {
            flex-shrink: 0;

            padding: 14px 20px;

            border: none;
            border-radius: 6px;

            background: var(--accent);

            color: #07100b;

            font-size: 13px;
            font-weight: 650;

            cursor: pointer;

            box-shadow: none;

            transition:
                transform 0.15s ease,
                background 0.15s ease;
        }

        .shorten-button:hover {
            background: var(--accent-hover);
        }

        .shorten-button:active {
            transform: translateY(1px);
        }

        /* LOGIN PROMPT */

        .login-prompt {
            max-width: 720px;

            margin: 20px auto 0;
            padding: 14px 18px;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;

            border: 1px solid var(--border);
            border-radius: 10px;

            background: var(--surface);

            color: var(--muted);

            font-size: 13px;
        }

        .login-prompt a {
            color: var(--accent);
            font-weight: 600;
        }

        .login-prompt a:hover {
            color: var(--accent-hover);
        }

        .login-actions {
            display: flex;
            align-items: center;
            gap: 18px;
            flex-shrink: 0;
        }

        /* RESULT */

        .result {
            margin: 14px 2px 2px;
            padding: 16px;

            border: 1px solid var(--border-strong);
            border-radius: 8px;

            background: var(--surface);

            text-align: left;
        }

        .result-label {
            margin-bottom: 10px;

            color: var(--accent);

            font-size: 13px;
            font-weight: 700;
        }

        .result-row {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .result-link {
            flex: 1;
            min-width: 0;

            padding: 11px 13px;

            border: 1px solid var(--border);
            border-radius: 6px;

            background: #0d1210;

            color: var(--secondary);

            font-size: 13px;

            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .copy-button {
            flex-shrink: 0;

            padding: 11px 15px;

            border: 1px solid var(--border-strong);
            border-radius: 6px;

            background: var(--surface-secondary);
            color: var(--text);

            font-size: 12px;
            font-weight: 500;

            cursor: pointer;

            transition:
                background 0.15s ease,
                border-color 0.15s ease;
        }

        .copy-button:hover {
            background: var(--surface-secondary);
            border-color: var(--border-strong);
        }

        /* FEATURES */

        .features {
            max-width: 900px;
            margin: 40px auto 0;
            padding-top: 16px;
            border-top: 1px solid var(--border-strong);

            text-align: left;
        }

        .features-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            padding-bottom: 12px;

            border-bottom: 1px solid var(--border-strong);
        }

        .features-title {
            font-size: 13px;
            font-weight: 650;
        }

        .features-subtitle {
            color: var(--muted);

            font-size: 12px;
        }

        .feature-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);

            border-left: 1px solid var(--border-strong);
            border-top: 1px solid var(--border-strong);
            border-radius: 7px;
            overflow: hidden;
        }

        .feature {
            min-height: 142px;

            padding: 18px 20px;

            border-right: 1px solid var(--border-strong);
            border-bottom: 1px solid var(--border-strong);
            background: var(--surface);

            transition: background 0.15s ease;
        }

        .feature:hover {
            background: var(--surface-secondary);
        }

        .feature-number {
            margin-bottom: 18px;

            color: var(--accent);

            font-size: 11px;
            font-weight: 600;
        }

        .feature h3 {
            margin-bottom: 8px;

            font-size: 14px;
            font-weight: 650;
        }

        .feature p {
            color: var(--muted);

            font-size: 12px;
            line-height: 1.65;
        }

        /* FOOTER */

        footer {
            display: flex;
            align-items: center;
            justify-content: space-between;

            padding: 18px 36px;

            border-top: 1px solid var(--border);

            color: var(--muted);

            font-size: 11px;
        }

        /* MOBILE */

        @media (max-width: 650px) {

            body {
                padding: 12px;
            }

            .container {
                width: 100%;
                border-radius: 18px;
            }

            nav {
                height: 68px;
                padding: 0 16px;
            }

            .nav-actions {
                gap: 12px;
            }

            main {
                padding: 40px 18px 32px;
            }

            h1 {
                font-size: 32px;
            }

            h1 br {
                display: none;
            }

            .description {
                font-size: 14px;
            }

            .brand-tagline {
                font-size: 10px;
            }

            .shortener-card {
                padding: 6px;
            }

            .login-prompt {
                align-items: flex-start;
                flex-direction: column;
                gap: 10px;
            }

            .url-form {
                flex-direction: column;
            }

            .url-input {
                width: 100%;
                margin-right: 0;
            }

            .shorten-button {
                width: 100%;
            }

            .result-row {
                flex-direction: column;
                align-items: stretch;
            }

            .copy-button {
                width: 100%;
            }

            .feature-grid {
                grid-template-columns: 1fr;
            }

            .feature {
                border-bottom: 1px solid var(--border-strong);
            }

            .feature {
                min-height: auto;
            }

            footer {
                flex-direction: column;
                align-items: flex-start;
                gap: 7px;
                padding: 16px;
            }
        }
    </style>
</head>


<body>

    <div class="container">

        <!-- NAVBAR -->

        <nav>

            <a href="/" class="brand">

                <span class="brand-icon">
                    T
                </span>

                <span class="brand-copy">
                    <span class="brand-name">Trace</span>
                    <span class="brand-tagline">Short links. Clear insights.</span>
                </span>

            </a>


            <div class="nav-actions">

                <% if (locals.user || locals.shortId) { %>

                    <a href="/dashboard" class="nav-link">
                        Dashboard
                    </a>

                    <a href="/logout" class="nav-button">
                        Logout
                    </a>

                    <% } else { %>

                        <a href="/login" class="nav-link">
                            Login
                        </a>

                        <a href="/signup" class="nav-button">
                            Sign up
                        </a>

                        <% } %>

            </div>

        </nav>


        <!-- MAIN -->

        <main>

            <section class="hero">

                <div class="eyebrow">

                    <span class="eyebrow-dot"></span>

                    URL SHORTENER

                </div>


                <h1>
                    Turn long links into<br>
                    <span>something worth tracking.</span>
                </h1>


                <p class="description">
                    Create short, shareable links and keep track of their activity.
                </p>


                <!-- SHORTENER -->

                <% if (locals.user || locals.shortId) { %>

                    <div class="shortener-card">

                        <form class="url-form" action="/url" method="POST">

                            <input class="url-input" type="url" name="url"
                                placeholder="https://example.com/your-long-url" required>

                            <button class="shorten-button" type="submit">
                                Create Trace
                            </button>

                        </form>


                        <% if (locals.shortId) { %>

                            <div class="result">

                                <div class="result-label">
                                    Your Trace is ready
                                </div>

                                <div class="result-row">

                                    <div class="result-link" id="shortUrl">
                                        http://localhost:8001/<%= locals.shortId %>
                                    </div>

                                    <button type="button" class="copy-button" onclick="copyUrl()">
                                        Copy
                                    </button>

                                </div>

                            </div>

                            <% } %>

                    </div>


                    <% } else { %>

                        <div class="login-prompt">
                            <span>Log in to create and track your links.</span>
                            <div class="login-actions">
                                <a href="/login">Login</a>
                                <a href="/signup">Sign up</a>
                            </div>
                        </div>

                        <% } %>


                            <!-- FEATURES -->

                            <section class="features">

                                <div class="features-header">

                                    <div class="features-title">
                                        Why Trace?
                                    </div>

                                    <div class="features-subtitle">
                                        Built for clarity.
                                    </div>

                                </div>


                                <div class="feature-grid">

                                    <div class="feature">

                                        <div class="feature-number">
                                            01
                                        </div>

                                        <h3>
                                            Instant links
                                        </h3>

                                        <p>
                                            Create clean, shareable short links in seconds.
                                        </p>

                                    </div>


                                    <div class="feature">

                                        <div class="feature-number">
                                            02
                                        </div>

                                        <h3>
                                            Track activity
                                        </h3>

                                        <p>
                                            Every link can keep a record of visits and activity.
                                        </p>

                                    </div>


                                    <div class="feature">

                                        <div class="feature-number">
                                            03
                                        </div>

                                        <h3>
                                            Built with Node.js
                                        </h3>

                                        <p>
                                            Express handles routing while MongoDB
                                            stores your link data.
                                        </p>

                                    </div>

                                </div>

                            </section>

            </section>

        </main>


        <!-- FOOTER -->

        <footer>

            <span>
                Trace
            </span>

            <span>
                Node.js · Express · MongoDB · EJS
            </span>

        </footer>

    </div>


    <script>

        function copyUrl() {

            const url =
                document.getElementById("shortUrl").innerText;

            navigator.clipboard.writeText(url);

            const button =
                document.querySelector(".copy-button");

            button.innerText = "Copied";

            setTimeout(() => {
                button.innerText = "Copy";
            }, 1500);

        }

    </script>

</body>

</html>