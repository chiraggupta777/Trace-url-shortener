<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create Account | Trace</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #090d0b;
            --surface: #101613;
            --surface-secondary: #141b17;
            --border: #26332d;
            --border-strong: #334139;
            --text: #f5f7f6;
            --secondary: #9aa7a0;
            --muted: #6f7c74;
            --accent: #63d39b;
            --accent-hover: #7be0ab;
            --accent-surface: #14261d;
        }

        body {
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
                Roboto, Helvetica, Arial, sans-serif;

            min-height: 100vh;
            background: var(--bg);

            color: var(--text);

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 30px;
        }

        .container {
            width: 100%;
            max-width: 1050px;

            display: grid;
            grid-template-columns: 1fr 1fr;

            background: var(--surface);
            border: 1px solid var(--border-strong);

            border-radius: 24px;
            overflow: hidden;

            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);

            backdrop-filter: blur(20px);
        }

        /* LEFT SIDE */

        .brand-section {
            padding: 55px;

            display: flex;
            flex-direction: column;
            justify-content: space-between;

            background: var(--surface-secondary);

            border-right: 1px solid var(--border);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;

            font-size: 21px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .logo-icon {
            width: 36px;
            height: 36px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;

            background: var(--accent);
            color: #07100b;

            font-size: 18px;

            box-shadow: none;
        }

        .hero {
            margin-top: 70px;
        }

        .hero h1 {
            font-size: 46px;
            line-height: 1.08;

            letter-spacing: -2px;

            max-width: 420px;
        }

        .hero h1 span {
            color: var(--accent);
        }

        .hero p {
            margin-top: 22px;

            color: var(--secondary);

            font-size: 16px;
            line-height: 1.7;

            max-width: 410px;
        }

        .features {
            margin-top: 38px;

            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .feature {
            display: flex;
            align-items: center;
            gap: 12px;

            color: var(--secondary);

            font-size: 14px;
        }

        .check {
            width: 24px;
            height: 24px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background: var(--accent-surface);
            color: var(--accent);

            font-size: 12px;
        }

        .copyright {
            color: var(--muted);
            font-size: 12px;
        }


        /* RIGHT SIDE */

        .form-section {
            padding: 55px;

            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-header {
            margin-bottom: 32px;
        }

        .form-header h2 {
            font-size: 28px;
            letter-spacing: -0.8px;
        }

        .form-header p {
            margin-top: 8px;

            color: var(--secondary);
            font-size: 14px;
        }

        .form {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        label {
            font-size: 13px;
            font-weight: 500;

            color: var(--secondary);
        }

        input {
            width: 100%;

            padding: 14px 15px;

            border-radius: 10px;

            border: 1px solid var(--border);

            background: #0d1210;

            color: var(--text);

            font-size: 14px;

            outline: none;

            transition: 0.2s ease;
        }

        input::placeholder {
            color: var(--muted);
        }

        input:focus {
            border-color: var(--accent);
            box-shadow: none;
        }

        .password-info {
            display: flex;
            justify-content: space-between;

            margin-top: 2px;

            font-size: 11px;
            color: var(--muted);
        }

        .submit-btn {
            margin-top: 8px;

            width: 100%;

            padding: 14px;

            border: none;
            border-radius: 10px;

            background: var(--accent);

            color: #07100b;

            font-size: 14px;
            font-weight: 600;

            cursor: pointer;

            transition: 0.2s ease;

            box-shadow: none;
        }

        .submit-btn:hover {
            transform: translateY(-1px);

            background: var(--accent-hover);
        }

        .login {
            margin-top: 25px;

            text-align: center;

            color: var(--secondary);

            font-size: 13px;
        }

        .login a {
            color: var(--accent);

            text-decoration: none;

            font-weight: 500;
        }

        .login a:hover {
            text-decoration: underline;
        }

        .terms {
            margin-top: 18px;

            text-align: center;

            color: var(--muted);

            font-size: 11px;

            line-height: 1.6;
        }

        .terms a {
            color: var(--secondary);
            text-decoration: none;
        }


        /* MOBILE */

        @media (max-width: 800px) {

            body {
                padding: 15px;
            }

            .container {
                grid-template-columns: 1fr;

                max-width: 500px;
            }

            .brand-section {
                display: none;
            }

            .form-section {
                padding: 40px 28px;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- LEFT -->

        <section class="brand-section">

            <div>

                <div class="logo">
                    <div class="logo-icon">↗</div>
                    Trace
                </div>

                <div class="hero">

                    <h1>
                        Short links.
                        <span>Big impact.</span>
                    </h1>

                    <p>
                        Create, manage and track your shortened URLs
                        from one simple dashboard.
                    </p>

                    <div class="features">

                        <div class="feature">
                            <div class="check">✓</div>
                            Fast and reliable URL shortening
                        </div>

                        <div class="feature">
                            <div class="check">✓</div>
                            Manage all your links in one place
                        </div>

                        <div class="feature">
                            <div class="check">✓</div>
                            Track your links effortlessly
                        </div>

                    </div>

                </div>

            </div>

            <div class="copyright">
                © 2026 Trace. Built for the web.
            </div>

        </section>


        <!-- RIGHT -->

        <section class="form-section">

            <div class="form-header">

                <h2>Create your account</h2>

                <p>
                    Start shortening links in seconds.
                </p>

            </div>


            <form class="form" action="/user" method="POST">

                <div class="input-group">

                    <label for="name">
                        Full name
                    </label>

                    <input type="text" id="name" name="name" placeholder="Enter your name" required>

                </div>


                <div class="input-group">

                    <label for="email">
                        Email address
                    </label>

                    <input type="email" id="email" name="email" placeholder="you@example.com" required>

                </div>


                <div class="input-group">

                    <label for="password">
                        Password
                    </label>

                    <input type="password" id="password" name="password" placeholder="Create a strong password"
                        minlength="6" required>

                    <div class="password-info">
                        <span>Minimum 6 characters</span>
                        <span>Keep it secure</span>
                    </div>

                </div>


                <button type="submit" class="submit-btn">
                    Create account
                </button>

            </form>


            <div class="login">
                Already have an account?
                <a href="/login">Log in</a>
            </div>


            <div class="terms">
                By creating an account, you agree to our
                <a href="/terms">Terms &amp; Conditions</a>
                and
                Privacy Policy.
            </div>

        </section>

    </div>

</body>

</html>