<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard — Trace</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg: #090d0b;
            --surface: #101613;
            --surface-secondary: #141b17;
            --border: #26332d;
            --border-strong: #334139;
            --text: #f5f7f6;
            --secondary: #9aa7a0;
            --muted: #6f7c74;
            --accent: #63d39b;
            --accent-hover: #7be0ab;
            --accent-surface: #14261d;
        }

        body {
            min-height: 100vh;
            padding: 24px;
            color: var(--text);
            background: var(--bg);
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Roboto", "Helvetica", "Arial", "Segoe UI", sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button {
            font: inherit;
        }

        .shell {
            width: min(1120px, 100%);
            margin: 0 auto;
            overflow: hidden;
            border: 1px solid var(--border-strong);
            border-radius: 20px;
            background: var(--surface);
            box-shadow: 0 24px 56px rgba(0, 0, 0, 0.38);
        }

        .navbar {
            min-height: 74px;
            padding: 0 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .brand-mark {
            width: 36px;
            height: 36px;
            display: grid;
            place-items: center;
            border-radius: 7px;
            background: var(--accent);
            color: #07100b;
            font-size: 16px;
            font-weight: 700;
        }

        .brand-copy {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .brand-name {
            font-size: 19px;
            font-weight: 700;
            line-height: 1.1;
        }

        .brand-tagline {
            color: var(--muted);
            font-size: 11px;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 24px;
            font-size: 13px;
        }

        .nav-link {
            color: var(--muted);
        }

        .nav-link:hover {
            color: var(--text);
        }

        .nav-actions a[href="/dashboard"] {
            color: var(--accent);
        }

        .logout-link {
            padding: 9px 15px;
            border: 1px solid var(--border-strong);
            border-radius: 7px;
            background: var(--surface-secondary);
            color: var(--text);
            font-weight: 600;
        }

        .logout-link:hover,
        .copy-button:hover {
            background: var(--surface-secondary);
            border-color: var(--border-strong);
        }

        main {
            padding: 38px 36px 42px;
        }

        .page-heading {
            margin-bottom: 28px;
        }

        h1 {
            margin-bottom: 8px;
            font-size: 32px;
            line-height: 1.2;
        }

        .page-heading p {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 34px;
        }

        .stat-card {
            min-height: 112px;
            padding: 19px 20px;
            border: 1px solid var(--border-strong);
            border-radius: 10px;
            background: var(--surface);
        }

        .stat-label {
            color: var(--muted);
            font-size: 11px;
            font-weight: 650;
            letter-spacing: 0.7px;
            text-transform: uppercase;
        }

        .stat-value {
            margin-top: 12px;
            font-size: 28px;
            font-weight: 700;
            line-height: 1;
        }

        .stat-note {
            margin-top: 7px;
            color: var(--muted);
            font-size: 11px;
        }

        .links-section {
            border: 1px solid var(--border-strong);
            border-radius: 10px;
            background: var(--surface);
            overflow: hidden;
        }

        .section-heading {
            min-height: 58px;
            padding: 0 20px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid var(--border);
        }

        .section-heading h2 {
            font-size: 15px;
            font-weight: 650;
        }

        .table-scroll {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        th,
        td {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            vertical-align: middle;
        }

        th {
            color: var(--muted);
            font-size: 10px;
            font-weight: 650;
            letter-spacing: 0.6px;
            text-transform: uppercase;
        }

        td {
            color: var(--secondary);
            font-size: 12px;
        }

        tbody tr:last-child td {
            border-bottom: 0;
        }

        .original-url {
            display: block;
            max-width: 300px;
            overflow: hidden;
            color: var(--secondary);
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .short-url {
            display: block;
            max-width: 220px;
            overflow: hidden;
            color: var(--accent);
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .click-count,
        .created-date {
            white-space: nowrap;
        }

        .copy-button {
            min-width: 76px;
            padding: 8px 11px;
            border: 1px solid var(--border-strong);
            border-radius: 6px;
            background: var(--surface-secondary);
            color: var(--text);
            font-size: 11px;
            cursor: pointer;
        }

        .empty-state {
            padding: 44px 20px;
            text-align: center;
        }

        .empty-state h3 {
            margin-bottom: 8px;
            font-size: 16px;
        }

        .empty-state p {
            margin-bottom: 18px;
            color: var(--muted);
            font-size: 13px;
        }

        .create-link {
            display: inline-block;
            padding: 9px 14px;
            border: 1px solid var(--accent);
            border-radius: 7px;
            background: var(--accent);
            color: #07100b;
            font-size: 12px;
            font-weight: 600;
        }

        footer {
            min-height: 54px;
            padding: 0 36px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid var(--border);
            color: var(--muted);
            font-size: 11px;
        }

        @media (max-width: 760px) {
            body {
                padding: 14px;
            }

            .navbar {
                padding: 0 20px;
            }

            main {
                padding: 30px 20px 32px;
            }

            .stats {
                gap: 10px;
            }

            .stat-card {
                padding: 16px;
            }

            .table-scroll table {
                min-width: 720px;
            }

            footer {
                padding: 14px 20px;
            }
        }

        @media (max-width: 520px) {
            .navbar {
                min-height: 68px;
                padding: 0 14px;
            }

            .brand-tagline {
                font-size: 10px;
            }

            .nav-actions {
                gap: 12px;
                font-size: 12px;
            }

            .logout-link {
                padding: 8px 10px;
            }

            main {
                padding: 26px 14px 28px;
            }

            .page-heading {
                margin-bottom: 22px;
            }

            h1 {
                font-size: 27px;
            }

            .stats {
                grid-template-columns: 1fr;
                margin-bottom: 26px;
            }

            .stat-card {
                min-height: 0;
                padding: 14px 16px;
            }

            .stat-value {
                margin-top: 8px;
                font-size: 24px;
            }

            footer {
                align-items: flex-start;
                flex-direction: column;
                justify-content: center;
                gap: 5px;
                padding: 13px 14px;
            }
        }
    </style>
</head>

<body>
    <div class="shell">
        <nav class="navbar">
            <a href="/" class="brand">
                <span class="brand-mark">S</span>
                <span class="brand-copy">
                    <span class="brand-name">Trace</span>
                    <span class="brand-tagline">Short links. Clear insights.</span>
                </span>
            </a>

            <div class="nav-actions">
                <a href="/" class="nav-link">Home</a>
                <a href="/dashboard" class="nav-link">Dashboard</a>
                <a href="/logout" class="logout-link">Logout</a>
            </div>
        </nav>

        <main>
            <header class="page-heading">
                <h1>Your Dashboard</h1>
                <p>Manage your links and track their activity.</p>
            </header>

            <section class="stats" aria-label="Link statistics">
                <article class="stat-card">
                    <div class="stat-label">Total Links</div>
                    <div class="stat-value">
                        <%= stats.totalLinks %>
                    </div>
                </article>
                <article class="stat-card">
                    <div class="stat-label">Total Clicks</div>
                    <div class="stat-value">
                        <%= stats.totalClicks %>
                    </div>
                </article>
                <article class="stat-card">
                    <div class="stat-label">Recent Links</div>
                    <div class="stat-value">
                        <%= stats.recentLinks %>
                    </div>
                    <div class="stat-note">Past 7 days</div>
                </article>
            </section>

            <section class="links-section">
                <div class="section-heading">
                    <h2>Your Links</h2>
                </div>

                <% if (urls.length) { %>
                    <div class="table-scroll">
                        <table>
                            <thead>
                                <tr>
                                    <th>Original URL</th>
                                    <th>Short Link</th>
                                    <th>Clicks</th>
                                    <th>Created</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% urls.forEach((url)=> { %>
                                    <tr>
                                        <td><span class="original-url" title="<%= url.redirectUrl %>">
                                                <%= url.redirectUrl %>
                                            </span></td>
                                        <td><a class="short-url" href="<%= url.shortUrl %>" title="<%= url.shortUrl %>">
                                                <%= url.shortUrl %>
                                            </a></td>
                                        <td class="click-count">
                                            <%= url.clicks %>
                                        </td>
                                        <td class="created-date">
                                            <%= new Date(url.createdAt).toLocaleDateString("en-US", { month: "short" ,
                                                day: "numeric" , year: "numeric" }) %>
                                        </td>
                                        <td><button class="copy-button" type="button" data-url="<%= url.shortUrl %>"
                                                onclick="copyShortUrl(this)">Copy</button></td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } else { %>
                        <div class="empty-state">
                            <h3>No links yet</h3>
                            <p>Create your first Trace from the home page.</p>
                            <a class="create-link" href="/">Create a link</a>
                        </div>
                        <% } %>
            </section>
        </main>

        <footer>
            <span>Trace</span>
            <span>Node.js · Express · MongoDB · EJS</span>
        </footer>
    </div>

    <script>
        async function copyShortUrl(button) {
            const originalLabel = button.textContent;

            try {
                await navigator.clipboard.writeText(button.dataset.url);
                button.textContent = "Copied!";
            } catch {
                button.textContent = "Copy failed";
            }

            setTimeout(() => {
                button.textContent = originalLabel;
            }, 1500);
        }
    </script>
</body>

</html>